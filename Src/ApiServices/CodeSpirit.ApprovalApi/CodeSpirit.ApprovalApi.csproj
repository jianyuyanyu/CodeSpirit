<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Microsoft.EntityFrameworkCore.SqlServer 通过 CodeSpirit.Shared 传递 -->
    <!-- Pomelo.EntityFrameworkCore.MySql 通过 CodeSpirit.Shared 传递 -->
    <PackageReference Include="AutoMapper" />
    <!-- Newtonsoft.Json 通过 CodeSpirit.Shared 传递 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CodeSpirit.Core\CodeSpirit.Core.csproj" />
    <ProjectReference Include="..\..\CodeSpirit.Shared\CodeSpirit.Shared.csproj" />
    <ProjectReference Include="..\..\CodeSpirit.ServiceDefaults\CodeSpirit.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.AiFormFill\CodeSpirit.AiFormFill.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.Audit\CodeSpirit.Audit.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.ConfigCenter.Sdk\CodeSpirit.ConfigCenter.Sdk.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.MultiTenant\CodeSpirit.MultiTenant.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.LLM\CodeSpirit.LLM.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.Settings\CodeSpirit.Settings.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.Amis\CodeSpirit.Amis.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.Authorization\CodeSpirit.Authorization.csproj" />
    <ProjectReference Include="..\..\Components\CodeSpirit.Navigation\CodeSpirit.Navigation.csproj" />
  </ItemGroup>

</Project>
