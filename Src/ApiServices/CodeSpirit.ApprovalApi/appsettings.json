{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "MigrationsAssembly": "CodeSpirit.ApprovalApi"
  },
  "ApprovalApi": {
    "EnableIntelligentApproval": true,
    "DefaultTimeoutHours": 72,
    "EnableAutoReminder": true,
    "ReminderIntervalHours": 24,
    "EnableApprovalLog": true
  },
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default",
    "TenantHeaderName": "X-Tenant-Id"
  },
  "LLM": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4"
  },
  "Audit": {
    "Enabled": true,
    "StorageProvider": "RabbitMQ",
    "LogRequestParams": true,
    "LogResponseData": true,
    "LogUnauthorizedRequests": true,
    "LogAnonymousRequests": false,
    "EnableOperationTypeInference": true,
    "EnableGeoLocation": true,
    "ExcludedPathPrefixes": [ "/health", "/metrics", "/favicon.ico" ],
    "RabbitMQ": {
      "ExchangeName": "audit.exchange",
      "QueueName": "audit.queue",
      "RoutingKey": "audit.log"
    },
    "SensitiveData": {
      "Enabled": true,
      "SensitiveFieldPatterns": [ "password", "pwd", "secret", "token", "apiKey", "key", "auth", "credential" ],
      "MaskCharacter": "*",
      "KeepFirstChars": 0,
      "KeepLastChars": 0,
      "ExcludedFields": [ "password", "newPassword", "confirmPassword", "currentPassword" ]
    }
  }
}
