<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>false</InvariantGlobalization>
		<UserSecretsId>5edcf4b6-a4ef-47c6-b452-ede79ea812f6</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>..\..</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="publish\**" />
	  <Content Remove="publish\**" />
	  <EmbeddedResource Remove="publish\**" />
	  <None Remove="publish\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 注意：Aspire 13.1.0 的 EF Core 集成需要 EF Core 10.0.1，但 Pomelo 9.0.0 不支持 EF Core 10 -->
		<!-- 因此使用默认的 EF Core 9.0.9 版本，通过 CodeSpirit.Shared 传递 Pomelo -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Azure.AI.OpenAI" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
		<PackageReference Include="QuestPDF" />
		<PackageReference Include="QRCoder" />
		<!-- Pomelo.EntityFrameworkCore.MySql 通过 CodeSpirit.Shared 传递 -->
		<!-- LinqKit.Core 通过 CodeSpirit.Shared 传递 -->
		<!-- Newtonsoft.Json 通过 CodeSpirit.Shared 传递 -->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\CodeSpirit.ServiceDefaults\CodeSpirit.ServiceDefaults.csproj" />
		<ProjectReference Include="..\..\CodeSpirit.Core\CodeSpirit.Core.csproj" />
		<ProjectReference Include="..\..\CodeSpirit.Shared\CodeSpirit.Shared.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.Audit\CodeSpirit.Audit.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.Charts\CodeSpirit.Charts.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.ConfigCenter.Sdk\CodeSpirit.ConfigCenter.Sdk.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.MultiTenant\CodeSpirit.MultiTenant.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.Settings\CodeSpirit.Settings.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.LLM\CodeSpirit.LLM.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.AiFormFill\CodeSpirit.AiFormFill.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.Caching\CodeSpirit.Caching.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.ScheduledTasks\CodeSpirit.ScheduledTasks.csproj" />
		<ProjectReference Include="..\..\Components\CodeSpirit.Localization\CodeSpirit.Localization.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\ExamDisplay.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>ExamDisplay.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
		<!-- 嵌入资源文件 -->
		<EmbeddedResource Update="Resources\ExamDisplay.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>ExamDisplay.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<!-- 附属资源文件不需要代码生成器 -->
		<EmbeddedResource Update="Resources\ExamDisplay.en.resx">
			<DependentUpon>ExamDisplay.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

</Project>
