{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CodeSpirit.Audit": "Debug",
      "CodeSpirit.Audit.Services.LLM": "Debug",
      "CodeSpirit.Audit.LLM": "Debug"
    }
  },
  "ConnectionStrings": {
    "cache": "redis:6379,defaultDatabase=0,abortConnect=false,connectTimeout=10000,syncTimeout=10000,asyncTimeout=10000,connectRetry=3,keepAlive=60,allowAdmin=false"
  },
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default"
  },
  "Jwt": {
    "SecretKey": "ECBF8FA013844D77AE041A6800D7FF8F",
    "Issuer": "codespirit.com",
    "Audience": "CodeSpirit"
  },
  "Aspire": {
    "Seq": {
      "DisableHealthChecks": true,
      "ServerUrl": "http://seq:5341"
    },
    "RabbitMQ": {
      "Client": {
        "ConnectionString": "amqp://admin:Password123@rabbitmq:5672",
        "DisableHealthChecks": true,
        "DisableTracing": true,
        "ExchangeName": "codespirit_event_bus"
      }
    }
  },
  "AllowedHosts": "*",
  "PathPrefix": {
    "Enabled": false,
    "Prefix": "exam",
    "ApplyToHealthChecks": false
  },
  "Audit": {
    "Enabled": true,
    "StorageProvider": "RabbitMQ",
    "LogRequestParams": true,
    "LogResponseData": true,
    "LogUnauthorizedRequests": true,
    "LogAnonymousRequests": false,
    "EnableOperationTypeInference": true,
    "EnableGeoLocation": true,
    "ExcludedPathPrefixes": [ "/health", "/metrics", "/swagger", "/favicon.ico" ],
    "RabbitMQ": {
      "ExchangeName": "audit.exchange",
      "QueueName": "audit.queue",
      "RoutingKey": "audit.log"
    },
    "SensitiveData": {
      "Enabled": true,
      "SensitiveFieldPatterns": [ "password", "pwd", "secret", "token", "apiKey", "key", "auth", "credential" ],
      "MaskCharacter": "*",
      "KeepFirstChars": 0,
      "KeepLastChars": 0,
      "ExcludedFields": [ "password", "newPassword", "confirmPassword", "currentPassword" ]
    },
    "LLMAudit": {
      "Enabled": true,
      "LogPrompts": true,
      "LogResponses": true,
      "LogProcessedData": false,
      "MaxPromptLength": 10000,
      "MaxResponseLength": 50000,
      "RabbitMQ": {
        "ExchangeName": "llm.audit.exchange",
        "QueueName": "llm.audit.queue",
        "RoutingKey": "llm.audit.log"
      },
      "SensitiveData": {
        "Enabled": true,
        "SensitiveFieldPatterns": [
          "password",
          "pwd", 
          "secret",
          "token",
          "apiKey"
        ],
        "MaskCharacter": "*",
        "KeepFirstChars": 0,
        "KeepLastChars": 0
      },
      "CostCalculation": {
        "Enabled": true,
        "ModelPricing": {
          "gpt-4": {
            "InputPer1K": 0.03,
            "OutputPer1K": 0.06
          },
          "gpt-3.5-turbo": {
            "InputPer1K": 0.0015,
            "OutputPer1K": 0.002
          },
          "qwen-plus": {
            "InputPer1K": 0.004,
            "OutputPer1K": 0.012
          }
        }
      },
      "ScenarioMapping": {
        "QuestionGeneration": "题目生成",
        "QuestionAudit": "题目审核", 
        "QuestionCorrection": "题目校正",
        "ContentGeneration": "内容生成"
      }
    }
  },
  "PdfGeneration": {
    "MaxConcurrentJobs": 5,
    "BrowserPoolSize": 3,
    "BrowserTimeout": "00:02:00",
    "Headless": true,
    "RetryCount": 3,
    "BrowserMemoryLimit": 512,
    "BrowserArguments": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--no-first-run",
      "--no-zygote",
      "--single-process"
    ]
  },
  "ScheduledTasks": {
    "Enabled": true,
    "DefaultTimeout": "00:10:00",
    "MaxConcurrentTasks": 5,
    "TaskCleanupInterval": "01:00:00",
    "ExecutionHistoryRetention": "7.00:00:00",
    "Tasks": [
      {
        "Id": "exam-cache-warmup",
        "Name": "考试缓存预热任务",
        "Description": "每5分钟预热即将开始的考试缓存，提升考试开始时的性能",
        "Type": "Cron",
        "CronExpression": "0 */5 * * * *",
        "HandlerType": "CodeSpirit.ExamApi.Tasks.ExamCacheWarmupTaskHandler",
        "Timeout": "00:05:00",
        "Enabled": true
      },
      {
        "Id": "exam-record-cleanup",
        "Name": "考试记录垃圾数据清理",
        "Description": "清理未使用的预生成考试记录（考试已结束7天后）",
        "Type": "Cron",
        "CronExpression": "0 0 2 * * *",
        "HandlerType": "CodeSpirit.ExamApi.Tasks.ExamRecordCleanupTaskHandler",
        "Parameters": "{\"cleanupDays\": 7}",
        "Timeout": "00:10:00",
        "Enabled": true
      }
    ]
  }
}