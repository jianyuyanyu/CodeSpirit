<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>ff14fa7a-db19-49eb-909e-0cf7c08f785a</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
    </PropertyGroup>

    <ItemGroup>
        <!-- 注意：Aspire 13.1.0 的 EF Core 集成需要 EF Core 10.0.1，但 Pomelo 9.0.0 不支持 EF Core 10 -->
        <!-- 因此使用默认的 EF Core 9.0.9 版本，通过 CodeSpirit.Shared 传递 Pomelo -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="SixLabors.ImageSharp" />
        <PackageReference Include="Tencent.QCloud.Cos.Sdk" />
        <PackageReference Include="Aliyun.OSS.SDK.NetCore" />
        <PackageReference Include="MetadataExtractor" />
        <!-- Pomelo.EntityFrameworkCore.MySql 通过 CodeSpirit.Shared 传递 -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\CodeSpirit.ServiceDefaults\CodeSpirit.ServiceDefaults.csproj" />
        <ProjectReference Include="..\..\CodeSpirit.Core\CodeSpirit.Core.csproj" />
        <ProjectReference Include="..\..\CodeSpirit.Shared\CodeSpirit.Shared.csproj" />
        <ProjectReference Include="..\..\Components\CodeSpirit.Audit\CodeSpirit.Audit.csproj" />
        <ProjectReference Include="..\..\Components\CodeSpirit.ConfigCenter.Sdk\CodeSpirit.ConfigCenter.Sdk.csproj" />
        <ProjectReference Include="..\..\Components\CodeSpirit.MultiTenant\CodeSpirit.MultiTenant.csproj" />
    </ItemGroup>

</Project>
