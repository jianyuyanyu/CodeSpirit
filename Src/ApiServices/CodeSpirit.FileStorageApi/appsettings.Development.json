{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CodeSpirit": "Debug"
    }
  },
  "ConnectionStrings": {
    "file-api": "Server=(LocalDB)\\MSSQLLocalDB;Database=codespirit-file;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "FileStorage": {
    "StorageProviders": {
      "Local": {
        "Properties": {
          "RootPath": "wwwroot/uploads",
          "BaseUrl": "https://localhost:7001/files"
        }
      }
    },
    "Buckets": {
      "default": {
        "MaxFileSize": 52428800,
        "Properties": {
          "EnableThumbnail": true
        }
      },
      "images": {
        "MaxFileSize": 5242880,
        "Properties": {
          "EnableThumbnail": true,
          "WatermarkEnabled": false
        }
      }
    }
  }
}
