{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning",
      "CodeSpirit.Audit": "Debug",
      "CodeSpirit.Audit.Filters.AuditMetadataFilter": "Debug"
    }
  },
  "ConnectionStrings": {
    "cache": "redis:6379,defaultDatabase=0,abortConnect=false,connectTimeout=5000,syncTimeout=5000"
  },
  "Jwt": {
    "SecretKey": "ECBF8FA013844D77AE041A6800D7FF8F",
    "Issuer": "codespirit.com",
    "Audience": "CodeSpirit"
  },
  "MultiTenant": {
    "Enabled": true
  },
  "Audit": {
    "Enabled": true,
    "StorageProvider": "RabbitMQ",
    "LogRequestParams": true,
    "LogResponseData": true,
    "LogUnauthorizedRequests": true,
    "LogAnonymousRequests": false,
    "EnableOperationTypeInference": true,
    "EnableGeoLocation": true,
    "ExcludedPathPrefixes": [ "/health", "/metrics", "/swagger", "/favicon.ico" ],
    "RabbitMQ": {
      "ExchangeName": "audit.exchange",
      "QueueName": "audit.queue",
      "RoutingKey": "audit.log"
    },
    "SensitiveData": {
      "Enabled": true,
      "SensitiveFieldPatterns": [ "password", "pwd", "secret", "token", "apiKey", "key", "auth", "credential" ],
      "MaskCharacter": "*",
      "KeepFirstChars": 0,
      "KeepLastChars": 0,
      "ExcludedFields": [ "password", "newPassword", "confirmPassword", "currentPassword" ]
    }
  },
  "Aspire": {
    "Seq": {
      "DisableHealthChecks": true,
      "ServerUrl": "http://seq:5341"
    },
    "RabbitMQ": {
      "Client": {
        "ConnectionString": "amqp://admin:Password123@rabbitmq:5672",
        "DisableHealthChecks": true,
        "DisableTracing": true,
        "ExchangeName": "codespirit_event_bus"
      }
    }
  },
  "ConfigCenter": {
    "ServiceUrl": "http://config",
    "AppId": "identity",
    "AppSecret": "",
    "Environment": "Production",
    "AutoRegisterApp": true,
    "AppName": "Your App Name",
    "PollIntervalSeconds": 60,
    "UseSignalR": true,
    "EnableLocalCache": true,
    "LocalCacheDirectory": ".config-cache",
    "CacheExpirationMinutes": 1440,
    "PreferCache": false
  },
  "AllowedHosts": "*",
  "PathPrefix": {
    "Enabled": false,
    "Prefix": "identity",
    "ApplyToHealthChecks": false
  }
}