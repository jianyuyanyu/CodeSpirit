{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CodeSpirit": "Debug",
      "CodeSpirit.LLM": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "cache": "localhost:6379,defaultDatabase=0,abortConnect=false,connectTimeout=10000,syncTimeout=10000,asyncTimeout=10000,connectRetry=3,keepAlive=60,allowAdmin=false"
  },
  "Aspire": {
    "RabbitMQ": {
      "Client": {
        "ConnectionString": "amqp://admin:Password123@localhost:5672",
        "DisableHealthChecks": true,
        "DisableTracing": true,
        "ExchangeName": "codespirit_event_bus"
      }
    }
  },
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default"
  }
}

