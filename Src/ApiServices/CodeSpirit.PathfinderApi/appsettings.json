{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "CodeSpirit.Audit": "Debug",
      "CodeSpirit.Audit.Services.LLM": "Debug",
      "CodeSpirit.Audit.LLM": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Audit": {
    "Enabled": true,
    "StorageProvider": "RabbitMQ",
    "LogRequestParams": true,
    "LogResponseData": true,
    "LogUnauthorizedRequests": true,
    "LogAnonymousRequests": false,
    "EnableOperationTypeInference": true,
    "EnableGeoLocation": true,
    "ExcludedPathPrefixes": [ "/health", "/metrics", "/swagger", "/favicon.ico" ],
    "RabbitMQ": {
      "ExchangeName": "audit.exchange",
      "QueueName": "audit.queue",
      "RoutingKey": "audit.log"
    },
    "SensitiveData": {
      "Enabled": true,
      "SensitiveFieldPatterns": [ "password", "pwd", "secret", "token", "apiKey", "key", "auth", "credential" ],
      "MaskCharacter": "*",
      "KeepFirstChars": 0,
      "KeepLastChars": 0,
      "ExcludedFields": [ "password", "newPassword", "confirmPassword", "currentPassword" ]
    },
    "LLMAudit": {
      "Enabled": true,
      "LogPrompts": true,
      "LogResponses": true,
      "LogProcessedData": false,
      "MaxPromptLength": 10000,
      "MaxResponseLength": 50000,
      "RabbitMQ": {
        "ExchangeName": "llm.audit.exchange",
        "QueueName": "llm.audit.queue",
        "RoutingKey": "llm.audit.log"
      },
      "SensitiveData": {
        "Enabled": true,
        "SensitiveFieldPatterns": [
          "password",
          "pwd", 
          "secret",
          "token",
          "apiKey"
        ],
        "MaskCharacter": "*",
        "KeepFirstChars": 0,
        "KeepLastChars": 0
      },
      "CostCalculation": {
        "Enabled": true,
        "ModelPricing": {
          "gpt-4": {
            "InputPer1K": 0.03,
            "OutputPer1K": 0.06
          },
          "gpt-3.5-turbo": {
            "InputPer1K": 0.0015,
            "OutputPer1K": 0.002
          },
          "qwen-plus": {
            "InputPer1K": 0.004,
            "OutputPer1K": 0.012
          },
          "qwen-flash": {
            "InputPer1K": 0.0002,
            "OutputPer1K": 0.0006
          },
          "qwen3-max-preview":{
            "InputPer1K": 0.004,
            "OutputPer1K": 0.012
          },
          "qwen3-max":{
            "InputPer1K": 0.004,
            "OutputPer1K": 0.012
          },
          "qwen3-turbo":{
            "InputPer1K": 0.004,
            "OutputPer1K": 0.012
          }
        }
      },
      "ScenarioMapping": {
        "目标管理": "GoalManagement",
        "任务管理": "TaskManagement",
        "目标信息解析": "GoalInfoParsing",
        "AI任务拆解": "AITaskBreakdown"
      }
    }
  }
}

