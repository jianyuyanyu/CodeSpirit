{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "survey-api": "Server=(localdb)\\mssqllocaldb;Database=codespirit-survey;Trusted_Connection=True;MultipleActiveResultSets=true;Packet Size=512",
    "settings": "Server=(localdb)\\mssqllocaldb;Database=codespirit-settings;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default",
    "ResolveFromHeader": true,
    "TenantHeaderName": "TenantId",
    "ResolveFromQuery": true,
    "TenantQueryName": "tenantId",
    "ResolveFromSubdomain": false,
    "ResolveFromPath": false,
    "StoreType": "Memory",
    "EnableTenantCache": true,
    "CacheExpirationMinutes": 30,
    "EnableTenantValidation": false,
    "FailureStrategy": "UseDefault"
  }
}
