<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UserSecretsId>d27e03b0-72d5-4c42-b798-b63326828c36</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Content Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="publish\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeSpirit.ServiceDefaults\CodeSpirit.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CodeSpirit.Shared\CodeSpirit.Shared.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.Aggregator\CodeSpirit.Aggregator.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.Audit\CodeSpirit.Audit.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.Charts\CodeSpirit.Charts.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.Messaging\CodeSpirit.Messaging.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.MultiTenant\CodeSpirit.MultiTenant.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.Navigation\CodeSpirit.Navigation.csproj" />
    <ProjectReference Include="..\Components\CodeSpirit.UdlCards\CodeSpirit.UdlCards.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Seq" Version="9.5.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.OutputCaching" Version="9.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\Login.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
