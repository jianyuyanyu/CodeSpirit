@page "/demo/amis-charts-comparison"
@{
    ViewData["Title"] = "ECharts vs Amis Charts 对比演示";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h2 class="mb-0">📊 ECharts vs Amis Charts 对比演示</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        本页面展示了CodeSpirit Cards SDK中两种图表渲染方式的功能对比。
                        <strong>左侧</strong>使用传统的ECharts渲染器，<strong>右侧</strong>使用新的Amis Chart渲染器。
                    </p>
                    <div class="alert alert-info">
                        <strong>💡 使用提示：</strong> 修改下方的控制参数可以实时看到两种渲染器的表现差异。
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 控制面板 -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>🎛️ 控制面板</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>图表类型</label>
                                <select class="form-control" id="chartType">
                                    <option value="line">线图</option>
                                    <option value="bar">柱状图</option>
                                    <option value="area">面积图</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>主题</label>
                                <select class="form-control" id="chartTheme">
                                    <option value="default">默认</option>
                                    <option value="primary">主要</option>
                                    <option value="success">成功</option>
                                    <option value="warning">警告</option>
                                    <option value="danger">危险</option>
                                    <option value="info">信息</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>数据点数</label>
                                <input type="number" class="form-control" id="dataPoints" value="7" min="3" max="15">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label>图表高度</label>
                                <input type="number" class="form-control" id="chartHeight" value="300" min="200" max="500" step="50">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>&nbsp;</label>
                                <div>
                                    <button class="btn btn-primary btn-sm" onclick="refreshCharts()">🔄 刷新图表</button>
                                    <button class="btn btn-success btn-sm" onclick="generateRandomData()">🎲 随机数据</button>
                                    <button class="btn btn-info btn-sm" onclick="performanceTest()">⚡ 性能测试</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 图表对比区域 -->
    <div class="row">
        <!-- ECharts 渲染器 -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        📈 ECharts 渲染器
                        <span class="badge badge-warning">传统</span>
                    </h5>
                    <span class="text-muted" id="echarts-status">准备就绪</span>
                </div>
                <div class="card-body">
                    <div id="echarts-container" style="min-height: 350px;"></div>
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        <strong>特点：</strong> 功能强大，自定义程度高，需要加载ECharts库
                    </small>
                    <br>
                    <small class="text-muted">
                        <strong>渲染时间：</strong> <span id="echarts-time">--</span>
                    </small>
                </div>
            </div>
        </div>

        <!-- Amis Charts 渲染器 -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        📊 Amis Charts 渲染器
                        <span class="badge badge-success">新增</span>
                    </h5>
                    <span class="text-muted" id="amis-status">准备就绪</span>
                </div>
                <div class="card-body">
                    <div id="amis-container" style="min-height: 350px;"></div>
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        <strong>特点：</strong> 轻量级，主题一致，智能回退机制
                    </small>
                    <br>
                    <small class="text-muted">
                        <strong>渲染时间：</strong> <span id="amis-time">--</span>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- 功能特性对比 -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>📊 功能特性对比</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                                <tr>
                                    <th>特性</th>
                                    <th>ECharts 渲染器</th>
                                    <th>Amis Charts 渲染器</th>
                                    <th>推荐场景</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>依赖大小</strong></td>
                                    <td><span class="text-warning">~800KB (ECharts库)</span></td>
                                    <td><span class="text-success">~0KB (复用Amis)</span></td>
                                    <td>移动端、快速加载</td>
                                </tr>
                                <tr>
                                    <td><strong>加载速度</strong></td>
                                    <td><span class="text-warning">中等</span></td>
                                    <td><span class="text-success">快速</span></td>
                                    <td>用户体验要求高</td>
                                </tr>
                                <tr>
                                    <td><strong>主题一致性</strong></td>
                                    <td><span class="text-warning">需手动配置</span></td>
                                    <td><span class="text-success">自动同步</span></td>
                                    <td>设计规范统一</td>
                                </tr>
                                <tr>
                                    <td><strong>自定义能力</strong></td>
                                    <td><span class="text-success">非常强大</span></td>
                                    <td><span class="text-info">中等</span></td>
                                    <td>复杂图表需求</td>
                                </tr>
                                <tr>
                                    <td><strong>容错机制</strong></td>
                                    <td><span class="text-danger">无</span></td>
                                    <td><span class="text-success">智能回退</span></td>
                                    <td>稳定性要求高</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 全局变量
    let currentData = null;
    let performanceData = { echarts: [], amis: [] };

    // 页面加载完成后初始化
    document.addEventListener('DOMContentLoaded', function() {
        // 检查资源是否已加载
        let checkCount = 0;
        const maxChecks = 20; // 最多检查20次
        
        const checkResources = () => {
            checkCount++;
            console.log(`检查资源加载状态 (${checkCount}/${maxChecks})...`);
            
            if (typeof CodeSpiritCards !== 'undefined') {
                console.log('资源已加载，开始初始化');
                initialize();
            } else if (checkCount < maxChecks) {
                console.log('资源尚未加载，500ms后重试...');
                setTimeout(checkResources, 500);
            } else {
                console.error('资源加载超时');
                showError('资源加载超时。请检查网络连接或刷新页面重试。');
            }
        };
        
        // 立即开始检查
        checkResources();
    });

    function initialize() {
        console.log('开始初始化对比页面...');
        console.log('CodeSpiritCards:', typeof CodeSpiritCards);
        
        // 检查依赖
        if (typeof CodeSpiritCards === 'undefined') {
            console.error('CodeSpirit Cards SDK 未找到');
            showError('CodeSpirit Cards SDK 未加载。请确保 cards-sdk.js 文件已正确加载。');
            return;
        }

        try {
            // 绑定事件
            document.getElementById('chartType').addEventListener('change', refreshCharts);
            document.getElementById('chartTheme').addEventListener('change', refreshCharts);
            document.getElementById('chartHeight').addEventListener('change', refreshCharts);
            document.getElementById('dataPoints').addEventListener('change', function() {
                generateRandomData();
                refreshCharts();
            });

            // 生成初始数据
            generateRandomData();
            refreshCharts();

            console.log('对比演示页面初始化完成');
        } catch (error) {
            console.error('初始化失败:', error);
            showError(`初始化失败: ${error.message}`);
        }
    }

    function generateRandomData() {
        const pointCount = parseInt(document.getElementById('dataPoints').value);
        const categories = [];
        const values = [];

        for (let i = 0; i < pointCount; i++) {
            categories.push(`类目${i + 1}`);
            values.push(Math.floor(Math.random() * 100) + 20);
        }

        currentData = {
            chartTitle: '演示数据',
            xData: categories,
            yData: values
        };

        console.log('生成新数据:', currentData);
    }

    async function refreshCharts() {
        if (!currentData) {
            generateRandomData();
        }

        const chartType = document.getElementById('chartType').value;
        const theme = document.getElementById('chartTheme').value;
        const height = parseInt(document.getElementById('chartHeight').value);

        const chartData = {
            ...currentData,
            chartType: chartType
        };

        // 并行渲染两个图表
        await Promise.all([
            renderECharts(chartData, theme, height),
            renderAmisCharts(chartData, theme, height)
        ]);
    }

    async function renderECharts(chartData, theme, height) {
        const startTime = performance.now();
        
        try {
            document.getElementById('echarts-status').textContent = '渲染中...';
            
            const sdk = new CodeSpiritCards.SDK();
            const cards = [{
                id: 'echarts-demo',
                type: 'chart',
                title: `${chartData.chartType.toUpperCase()} 图表 (ECharts)`,
                subtitle: '传统ECharts渲染器',
                style: { theme, height },
                data: chartData
            }];

            await sdk.render('#echarts-container', cards);
            
            const endTime = performance.now();
            const renderTime = endTime - startTime;
            
            document.getElementById('echarts-status').textContent = '渲染完成';
            document.getElementById('echarts-time').textContent = `${renderTime.toFixed(1)}ms`;
            
            performanceData.echarts.push(renderTime);
            
            console.log('ECharts渲染完成:', renderTime.toFixed(1) + 'ms');
            
        } catch (error) {
            console.error('ECharts渲染失败:', error);
            document.getElementById('echarts-status').textContent = '渲染失败';
            document.getElementById('echarts-container').innerHTML = 
                '<div class="alert alert-danger">ECharts渲染失败: ' + error.message + '</div>';
        }
    }

    async function renderAmisCharts(chartData, theme, height) {
        const startTime = performance.now();
        
        try {
            document.getElementById('amis-status').textContent = '渲染中...';
            
            const sdk = new CodeSpiritCards.SDK();
            const cards = [{
                id: 'amis-demo',
                type: 'amis-chart',
                title: `${chartData.chartType.toUpperCase()} 图表 (Amis)`,
                subtitle: '新Amis Chart渲染器',
                style: { theme, height },
                data: chartData
            }];

            await sdk.render('#amis-container', cards);
            
            const endTime = performance.now();
            const renderTime = endTime - startTime;
            
            document.getElementById('amis-status').textContent = '渲染完成';
            document.getElementById('amis-time').textContent = `${renderTime.toFixed(1)}ms`;
            
            performanceData.amis.push(renderTime);
            
            console.log('Amis Charts渲染完成:', renderTime.toFixed(1) + 'ms');
            
        } catch (error) {
            console.error('Amis Charts渲染失败:', error);
            document.getElementById('amis-status').textContent = '渲染失败';
            document.getElementById('amis-container').innerHTML = 
                '<div class="alert alert-danger">Amis Charts渲染失败: ' + error.message + '</div>';
        }
    }

    async function performanceTest() {
        console.log('开始性能测试...');
        
        // 清空性能数据
        performanceData = { echarts: [], amis: [] };
        
        // 进行5次测试
        for (let i = 0; i < 5; i++) {
            generateRandomData();
            await refreshCharts();
            
            // 等待一段时间再进行下一次测试
            await new Promise(resolve => setTimeout(resolve, 500));
        }
        
        // 计算平均性能
        const echartsAvg = performanceData.echarts.reduce((a, b) => a + b, 0) / performanceData.echarts.length;
        const amisAvg = performanceData.amis.reduce((a, b) => a + b, 0) / performanceData.amis.length;
        
        alert(`性能测试完成！\n\nECharts平均渲染时间: ${echartsAvg.toFixed(1)}ms\nAmis Charts平均渲染时间: ${amisAvg.toFixed(1)}ms\n\n性能提升: ${((echartsAvg - amisAvg) / echartsAvg * 100).toFixed(1)}%`);
        
        console.log('性能测试结果:', {
            echarts: { avg: echartsAvg, data: performanceData.echarts },
            amis: { avg: amisAvg, data: performanceData.amis }
        });
    }

    function showError(message) {
        const errorHtml = `
            <div class="container-fluid p-4">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header bg-danger text-white">
                                <h4 class="mb-0">⚠️ 加载错误</h4>
                            </div>
                            <div class="card-body">
                                <p><strong>错误信息:</strong> ${message}</p>
                                <hr>
                                <p><strong>调试信息:</strong></p>
                                <ul>
                                    <li>页面URL: ${window.location.href}</li>
                                    <li>CodeSpiritCards: ${typeof CodeSpiritCards}</li>
                                    <li>脚本加载状态: ${document.querySelector('script[src*="cards-sdk.js"]') ? '已加载' : '未找到'}</li>
                                    <li>样式加载状态: ${document.querySelector('link[href*="cards-sdk.css"]') ? '已加载' : '未找到'}</li>
                                </ul>
                                <p><strong>解决方案:</strong></p>
                                <ol>
                                    <li>检查 cards-sdk.js 文件是否存在于 /wwwroot/cards-sdk/ 目录</li>
                                    <li>确保ASP.NET Core应用正常运行</li>
                                    <li>尝试刷新页面</li>
                                    <li>查看浏览器控制台了解详细错误</li>
                                </ol>
                                <button onclick="location.reload()" class="btn btn-primary mt-2">🔄 刷新页面</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        document.body.innerHTML = errorHtml;
    }

    // 调试函数
    window.debugComparison = function() {
        console.log('=== 对比页面调试信息 ===');
        console.log('当前数据:', currentData);
        console.log('性能数据:', performanceData);
        console.log('环境检查:', {
            cardsSDK: typeof CodeSpiritCards,
            amis: typeof amis,
            amisRequire: typeof amisRequire
        });
        
        // 检查容器
        const echartsContainer = document.getElementById('echarts-container');
        const amisContainer = document.getElementById('amis-container');
        
        console.log('容器状态:', {
            echarts: echartsContainer ? '存在' : '不存在',
            amis: amisContainer ? '存在' : '不存在'
        });
        
        if (amisContainer) {
            console.log('Amis容器内容:', amisContainer.innerHTML);
        }
    };
    
    // 手动触发Amis图表渲染的调试函数
    window.debugAmisChart = function() {
        if (currentData && typeof CodeSpiritCards !== 'undefined') {
            const sdk = new CodeSpiritCards.SDK();
            const config = {
                id: 'debug-amis',
                type: 'amis-chart',
                title: 'Debug Amis Chart',
                style: { theme: 'default', height: 300 },
                data: currentData
            };
            
            console.log('手动渲染Amis图表:', config);
            sdk.render('#amis-container', [config]);
        } else {
            console.error('无法渲染：数据或SDK不可用');
        }
    };
    
    // 检查Amis环境的调试函数
    window.checkAmisEnvironment = function() {
        console.log('=== Amis环境检查 ===');
        console.log('window.amis:', typeof window.amis, window.amis);
        console.log('window.amisRequire:', typeof window.amisRequire, window.amisRequire);
        
        if (window.amis) {
            console.log('amis.render:', typeof window.amis.render);
            console.log('amis.embed:', typeof window.amis.embed);
            console.log('amis版本:', window.amis.version || '未知');
        }
        
        if (window.amisRequire) {
            try {
                const amisCore = window.amisRequire('amis/embed');
                console.log('amisCore:', typeof amisCore, amisCore);
                if (amisCore) {
                    console.log('amisCore.render:', typeof amisCore.render);
                    console.log('amisCore.embed:', typeof amisCore.embed);
                }
            } catch (error) {
                console.error('amisRequire错误:', error);
            }
        }
        
        // 检查页面中是否有Amis相关的script标签
        const scripts = document.querySelectorAll('script[src*="amis"]');
        console.log('Amis相关脚本:', scripts.length, Array.from(scripts).map(s => s.src));
        
        return {
            amis: typeof window.amis,
            amisRequire: typeof window.amisRequire,
            hasRender: !!(window.amis?.render || window.amisRequire),
            scripts: scripts.length
        };
    };
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.0/echarts.min.js"></script>
    <script src="~/cards-sdk/cards-sdk.js"></script>
    <script src="~/cards-sdk/amis-integration.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/cards-sdk/cards-sdk.css" />
} 