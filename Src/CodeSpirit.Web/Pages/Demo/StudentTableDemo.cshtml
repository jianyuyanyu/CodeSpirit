    /**
     * 获取表格配置
     */
    function getTableSchema() {
        const enableStriped = document.getElementById('enableStriped').checked;
        const enableBordered = document.getElementById('enableBordered').checked;
        const enableHover = document.getElementById('enableHover').checked;
        
        return {
            "type": "table",
            "className": "table-card-table table-responsive",
            "affixHeader": false,
            "columns": [
                {
                    "name": "studentNumber",
                    "label": "学号",
                    "type": "text",
                    "sortable": true,
                    "width": 120
                },
                {
                    "name": "studentName",
                    "label": "姓名",
                    "type": "text",
                    "sortable": true,
                    "width": 100
                },
                {
                    "name": "grade",
                    "label": "班级",
                    "type": "text",
                    "hideOnMobile": isMobileView,
                    "width": 120
                },
                {
                    "name": "status",
                    "label": "状态",
                    "type": "mapping",
                    "sortable": true,
                    "width": 80,
                    "map": {
                        "online": "<span class=\"label label-success\">在线</span>",
                        "offline": "<span class=\"label label-danger\">离线</span>",
                        "submitted": "<span class=\"label label-info\">已提交</span>"
                    }
                },
                {
                    "name": "score",
                    "label": "成绩",
                    "type": "text",
                    "precision": 0,
                    "width": 80,
                    "hideOnMobile": isMobileView,
                    "tpl": "${score | number:0}"
                },
                {
                    "name": "lastActiveTime",
                    "label": "最后活跃",
                    "type": "datetime",
                    "format": "MM-DD HH:mm",
                    "width": 120
                }
            ],
            "bordered": enableBordered,
            "striped": enableStriped,
            "hover": enableHover,
            "data": studentData
        };
    }
    
    /**
     * 加载学生表格
     */
    function loadStudentTable() {
        console.log('加载学生表格...');
        
        try {
            amisRequire(['amis/embed'], function(amis) {
                const schema = getTableSchema();
                console.log('表格配置:', schema);
                
                // 清理之前的实例
                if (currentAmisInstance) {
                    currentAmisInstance.unmount();
                }
                
                // 创建新的Amis实例
                currentAmisInstance = amis.embed('#student-table-container', schema, {
                    locale: 'zh-CN',
                    theme: 'antd'
                });
                
                console.log('学生表格加载成功');
                
                // 更新状态指示器
                const statusIndicator = document.querySelector('.status-indicator span');
                if (statusIndicator) {
                    statusIndicator.textContent = `表格已加载 - 共${studentData.items.length}条学生记录`;
                }
                
            });
        } catch (error) {
            console.error('加载学生表格失败:', error);
            document.getElementById('student-table-container').innerHTML = 
                '<div class="alert alert-danger">表格加载失败: ' + error.message + '</div>';
        }
    }
    
    /**
     * 刷新表格数据
     */
    function refreshTable() {
        console.log('刷新表格数据...');
        
        // 模拟数据更新
        const now = new Date();
        studentData.items.forEach(item => {
            // 随机更新最后活跃时间
            if (Math.random() > 0.7) {
                item.lastActiveTime = now.toISOString();
            }
            
            // 随机更新状态
            if (Math.random() > 0.8) {
                const statuses = ['online', 'offline', 'submitted'];
                item.status = statuses[Math.floor(Math.random() * statuses.length)];
            }
        });
        
        // 重新加载表格
        loadStudentTable();
        
        // 显示刷新提示
        console.log('数据刷新完成');
    }
    
    /**
     * 切换移动端视图
     */
    function toggleMobileView() {
        isMobileView = !isMobileView;
        console.log('切换移动端视图:', isMobileView);
        
        // 重新加载表格以应用新设置
        if (currentAmisInstance) {
            loadStudentTable();
        }
        
        // 更新按钮文本
        const button = event.target;
        button.innerHTML = isMobileView ? 
            '<i class="fas fa-desktop"></i> 切换桌面端视图' : 
            '<i class="fas fa-mobile-alt"></i> 切换移动端视图';
    }
    
    /**
     * 更新表格样式
     */
    function updateTableStyle() {
        console.log('更新表格样式...');
        if (currentAmisInstance) {
            loadStudentTable();
        }
    }
    
    /**
     * 清空表格
     */
    function clearTable() {
        console.log('清空表格...');
        
        if (currentAmisInstance) {
            currentAmisInstance.unmount();
            currentAmisInstance = null;
        }
        
        document.getElementById('student-table-container').innerHTML = 
            '<div style="text-align: center; padding: 40px; color: #666;">' +
            '<i class="fas fa-table" style="font-size: 48px; margin-bottom: 16px; opacity: 0.3;"></i>' +
            '<p>表格已清空，点击"加载学生表格"重新加载</p>' +
            '</div>';
        
        // 重置状态指示器
        const statusIndicator = document.querySelector('.status-indicator span');
        if (statusIndicator) {
            statusIndicator.textContent = '表格已清空';
        }
    }
</script> 