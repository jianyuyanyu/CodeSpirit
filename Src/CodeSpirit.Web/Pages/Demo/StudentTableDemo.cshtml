@page "/demo/student-table-demo"
@{
    ViewData["Title"] = "学生数据表格演示";
    Layout = "_Layout";
}

<style>
    .demo-container {
        padding: 20px;
        background: #f8f9fa;
        min-height: 100vh;
    }
    
    .demo-header {
        background: white;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 24px;
    }
    
    .demo-section {
        background: white;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 24px;
    }
    
    .demo-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }
    
    .demo-title h2 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        color: #343a40;
    }
    
    .demo-badge {
        padding: 4px 12px;
        border-radius: 16px;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: linear-gradient(135deg, #4834d4, #686de0);
        color: white;
    }
    
    .demo-description {
        color: #666;
        line-height: 1.6;
        margin-bottom: 20px;
    }
    
    .controls-panel {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        border: 1px solid #e9ecef;
    }
    
    .btn-group {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }
    
    .btn-demo {
        padding: 8px 16px;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 14px;
    }
    
    .btn-demo:hover {
        background: #f8f9fa;
        border-color: #adb5bd;
    }
    
    .btn-demo.btn-primary {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }
    
    .btn-demo.btn-success {
        background: #28a745;
        color: white;
        border-color: #28a745;
    }
    
    .btn-demo.btn-info {
        background: #17a2b8;
        color: white;
        border-color: #17a2b8;
    }
    
    .btn-demo.btn-warning {
        background: #ffc107;
        color: #212529;
        border-color: #ffc107;
    }
    
    /* 自定义表格样式 */
    .table-card-table {
        font-size: 14px;
    }
    
    .table-card-table .label {
        display: inline-block;
        padding: 0.25em 0.6em;
        font-size: 75%;
        font-weight: 700;
        line-height: 1;
        color: #fff;
        text-align: center;
        white-space: nowrap;
        vertical-align: baseline;
        border-radius: 0.25rem;
    }
    
    .table-card-table .label-success {
        background-color: #28a745;
    }
    
    .table-card-table .label-danger {
        background-color: #dc3545;
    }
    
    .table-card-table .label-info {
        background-color: #17a2b8;
    }
    
    .amis-render-container {
        min-height: 400px;
    }
    
    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
    }
    
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #28a745;
        animation: pulse 2s infinite;
    }
    
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    
    .feature-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
        margin-top: 16px;
    }
    
    .feature-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px;
        background: #f8f9fa;
        border-radius: 4px;
        font-size: 14px;
    }
    
    .feature-icon {
        color: #28a745;
        font-size: 16px;
    }
</style>

<div class="demo-container">
    <!-- 页面标题 -->
    <div class="demo-header">
        <div class="demo-title">
            <h2>
                <i class="fas fa-table" style="color: #4834d4;"></i>
                学生数据表格演示
            </h2>
            <span class="demo-badge">Amis Table</span>
        </div>
        
        <div class="demo-description">
            基于Amis框架的高性能学生数据表格演示，展示实时状态监控、响应式设计和丰富的数据交互功能。
            表格包含学号、姓名、班级、状态、成绩和最后活跃时间等信息，支持排序、筛选和移动端适配。
        </div>
        
        <div class="status-indicator">
            <div class="status-dot"></div>
            <span>表格实时渲染 - 共50条学生记录</span>
        </div>
        
        <div class="feature-list">
            <div class="feature-item">
                <i class="fas fa-sort feature-icon"></i>
                <span>多列排序</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-mobile-alt feature-icon"></i>
                <span>响应式设计</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-tags feature-icon"></i>
                <span>状态标签映射</span>
            </div>
            <div class="feature-item">
                <i class="fas fa-clock feature-icon"></i>
                <span>时间格式化</span>
            </div>
        </div>
    </div>
    
    <!-- 控制面板 -->
    <div class="demo-section">
        <h3>
            <i class="fas fa-cogs"></i>
            控制面板
        </h3>
        
        <div class="controls-panel">
            <div class="btn-group">
                <button type="button" class="btn-demo btn-primary" onclick="loadStudentTable()">
                    <i class="fas fa-play"></i>
                    加载学生表格
                </button>
                <button type="button" class="btn-demo btn-success" onclick="refreshTable()">
                    <i class="fas fa-sync-alt"></i>
                    刷新数据
                </button>
                <button type="button" class="btn-demo btn-info" onclick="toggleMobileView()">
                    <i class="fas fa-mobile-alt"></i>
                    切换移动端视图
                </button>
                <button type="button" class="btn-demo btn-warning" onclick="clearTable()">
                    <i class="fas fa-trash"></i>
                    清空表格
                </button>
            </div>
            
            <div style="display: flex; gap: 16px; align-items: center;">
                <label>
                    <input type="checkbox" id="enableStriped" checked onchange="updateTableStyle()">
                    斑马纹
                </label>
                <label>
                    <input type="checkbox" id="enableBordered" checked onchange="updateTableStyle()">
                    边框
                </label>
                <label>
                    <input type="checkbox" id="enableHover" checked onchange="updateTableStyle()">
                    悬停效果
                </label>
            </div>
        </div>
    </div>
    
    <!-- 表格渲染区域 -->
    <div class="demo-section">
        <h3>
            <i class="fas fa-users"></i>
            学生数据表格
        </h3>
        
        <div id="student-table-container" class="amis-render-container">
            <div style="text-align: center; padding: 40px; color: #666;">
                <i class="fas fa-table" style="font-size: 48px; margin-bottom: 16px; opacity: 0.3;"></i>
                <p>点击"加载学生表格"按钮开始演示</p>
            </div>
        </div>
    </div>
</div>

