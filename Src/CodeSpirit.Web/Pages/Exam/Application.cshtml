@page "/{tenantId}/exam/app"
@model CodeSpirit.Web.Pages.Exam.ApplicationModel
@{
    ViewData["Title"] = "考试应用";
}

@section Head {
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="考试应用 - 移动端适配的考试管理平台">
    <meta name="theme-color" content="#1e88e5">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    
    <resource path="css/exam/application.css" type="css" />
}

<div id="root" class="exam-app-container">
    <div id="loading" class="exam-loading">
        <div class="exam-loading-spinner"></div>
        <p class="exam-loading-text">正在加载考试应用...</p>
    </div>
</div>

@section Scripts {
    <script>
        window.webHost = '@(HttpContext.Request.Scheme + "://" + HttpContext.Request.Host)';
        window.tenantId = '@Model.TenantId';
    </script>
    
    <resource path="js/exam/application.js" type="js" />
} 