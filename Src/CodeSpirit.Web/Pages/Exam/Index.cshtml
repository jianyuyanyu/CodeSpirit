@page "/{tenantId}/exam"
@model CodeSpirit.Web.Pages.Exam.IndexModel
@{
    ViewData["Title"] = "考试系统";
}

@section Head {
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="在线考试系统 - 安全可靠的考试平台">
    <resource path="css/exam/system.css" type="css" />
}

<div id="root" class="exam-system-container">
    <div id="loading" class="exam-loading">
        <div class="exam-loading-spinner"></div>
        <p class="exam-loading-text">正在加载考试系统...</p>
    </div>
</div>

@section Scripts {
    <script>
        window.webHost = '@(HttpContext.Request.Scheme + "://" + HttpContext.Request.Host)';
        window.tenantId = '@Model.TenantId';
    </script>
    
    <resource path="js/exam/system.js" type="js" />
} 