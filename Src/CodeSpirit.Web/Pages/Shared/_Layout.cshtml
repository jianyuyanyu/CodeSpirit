@using Microsoft.Extensions.Options
@using CodeSpirit.Web.Options
@using Microsoft.Extensions.Localization
@using SharedResources = CodeSpirit.Localization.Resources.SharedResources
@inject IOptions<SiteSettings> SiteOptions
@inject IStringLocalizer<SharedResources> SharedLocalizer
@{
    var cdnEnabled = SiteOptions.Value.EnableCdn;
    var resourceBase = cdnEnabled ? SiteOptions.Value.CdnUrl : "";
    var sdkVersion = "6.13.0";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var currentLanguage = currentCulture.Name;
    var amisLocale = currentLanguage == "en" ? "en-US" : "zh-CN";
}

<!DOCTYPE html>
<html lang="@currentLanguage">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"] - @Html.Raw(SiteOptions.Value.SiteName)</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />

    <!-- 样式表 -->
    <resource path="sdk/@(sdkVersion)/antd.css" type="css" />
    <resource path="sdk/@(sdkVersion)/helper.css" type="css" />
    <resource path="sdk/@(sdkVersion)/iconfont.css" type="css" />
    <resource path="css/chat.css" type="css" />

    <!-- 全局变量配置 -->
    <script>
        @{
                var isDevelopment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";
        }
        // 初始化全局命名空间
        window.CodeSpirit = window.CodeSpirit || {};

        window.webHost = '@(isDevelopment ? "https://localhost:7120" : SiteOptions.Value.WebHost)';

        // 站点配置
        window.siteSettings = {
            siteName: '@Html.Raw(SiteOptions.Value.SiteName)',
            topSiteName: '@Html.Raw(SiteOptions.Value.TopSiteName)',
            clientAppName: '@Html.Raw(SiteOptions.Value.TopSiteName) | @Html.Raw(SiteOptions.Value.SiteName)',
            logoUrl: '@SiteOptions.Value.LogoUrl',
            cdnEnabled: @(cdnEnabled ? "true" : "false"),
            cdnUrl: '@SiteOptions.Value.CdnUrl',
            resourceBase: '@resourceBase',
            apiBaseUrl: '@SiteOptions.Value.ApiBaseUrl'
        };

    // AMIS Locale 配置
    // 注意：AMIS JS SDK 从 1.1.0 开始已内置英文翻译（en-US），无需额外语言包文件
    // 只需在 amis.embed() 的 options 中设置 locale: 'en-US' 或 'zh-CN' 即可
    window.amisLocale = '@amisLocale';
    </script>

    <!-- i18n 辅助工具 -->
    <resource path="js/i18n-helper.js" type="js" />
    
    <!-- 初始化 i18n -->
    <script>
        // 初始化 i18n（资源可以从服务器端注入）
        window.CodeSpirit.i18n.init('@currentLanguage', {
            // 可以在这里注入常用的前端资源
            // 'Common.Save': '@SharedLocalizer["Common.Save"]',
            // 'Common.Cancel': '@SharedLocalizer["Common.Cancel"]'
        });
    </script>

    <!-- 动态加载 AMIS locale 文件（仅用于非内置语言，如德语 de-DE） -->
    @if (amisLocale != "zh-CN" && amisLocale != "en-US")
    {
        <script>
            // 异步加载 AMIS locale 文件（仅用于非内置语言）
            // 注意：AMIS JS SDK 内置支持 en-US 和 zh-CN，无需额外加载
            (function() {
                var script = document.createElement('script');
                script.src = '/sdk/@(sdkVersion)/locale/@(amisLocale).js';
                script.async = true;
                script.onload = function() {
                    // AMIS locale 加载完成后的回调
                    if (window.amisRequire && window.amisRequire.config) {
                        // 配置 AMIS 使用对应的 locale
                        console.log('AMIS locale loaded: @amisLocale');
                    }
                };
                document.head.appendChild(script);
            })();
        </script>
    }

    <!-- 脚本 -->
    <resource path="sdk/@(sdkVersion)/sdk.js" type="js" />
    <resource path="js/history.js" type="js" />
    @RenderSection("Head", required: false)  <!-- 可选的 Razor section -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="page-container">
        @RenderBody()  <!-- 页面主体内容 -->
    </div>
    <resource path="js/token-manager.js" type="js" />
    <!-- 考试系统API请求管理器 TODO:迁移到考试系统模板页-->
    <resource path="js/exam/api-manager.js" type="js" />
    @await RenderSectionAsync("Scripts", required: false)
    <script src="_framework/blazor.server.js"></script>
    <resource path="js/chat.js" type="js" />
</body>
</html>
