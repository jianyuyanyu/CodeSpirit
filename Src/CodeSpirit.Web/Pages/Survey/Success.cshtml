@page "/{tenantId?}/survey/success"
@model CodeSpirit.Web.Pages.Survey.SuccessModel
@{
    ViewData["Title"] = "提交成功";
    Layout = "_Layout";
}

<div class="survey-success-page">
    <div class="survey-success-background">
        <div class="success-particles">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>
    </div>
    
    <div class="container-fluid survey-success-container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-lg-6 col-md-8 col-12">
                <div class="survey-success-card">
                    <div class="survey-success-decoration"></div>
                    <div class="survey-success-badge">
                        <i class="fas fa-check"></i>
                    </div>
                    
                    <div class="survey-success-body">
                        <div class="survey-success-icon-container">
                            <div class="success-ripple"></div>
                            <div class="success-ripple"></div>
                            <div class="success-ripple"></div>
                            <i class="fas fa-check-circle survey-success-icon"></i>
                        </div>
                        
                        <h1 class="survey-success-title">问卷提交成功！</h1>
                        <p class="survey-success-message">
                            🎉 感谢您的参与！您的宝贵意见已成功提交，我们会认真对待每一份反馈，让我们一起创造更美好的体验。
                        </p>
                        
                        <div class="survey-success-stats">
                            <div class="success-stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-clock"></i>
                                </div>
                                <div class="stat-info">
                                    <span class="stat-number" id="completion-time">--</span>
                                    <span class="stat-label">完成用时</span>
                                </div>
                            </div>
                            <div class="success-stat-item">
                                <div class="stat-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="stat-info">
                                    <span class="stat-number">+1</span>
                                    <span class="stat-label">参与人数</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="survey-success-actions">
                            @{
                                var surveyListUrl = !string.IsNullOrEmpty(Model.TenantId) 
                                    ? $"/{Model.TenantId}/survey" 
                                    : "/survey";
                            }
                            <a href="@surveyListUrl" class="survey-success-btn primary">
                                <i class="fas fa-list mr-2"></i>
                                查看更多问卷
                            </a>
                            <a href="/" class="survey-success-btn secondary">
                                <i class="fas fa-home mr-2"></i>
                                返回首页
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <resource path="survey/js/survey-success.js" type="js" />
}

@section Styles {
    <resource path="survey/css/survey-success.css" type="css" />
}
