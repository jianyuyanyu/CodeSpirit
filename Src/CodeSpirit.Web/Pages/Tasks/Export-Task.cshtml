@model CodeSpirit.Web.Pages.Tasks.ExportTaskModel
@using Microsoft.Extensions.Options
@using CodeSpirit.Web.Options
@{
    ViewData["Title"] = "导出任务进度";
}

<div id="export-task-app"></div>

