@page "/Tasks/QuestionGeneration"
@model CodeSpirit.Web.Pages.Tasks.QuestionGenerationModel
@using Microsoft.Extensions.Options
@using CodeSpirit.Web.Options
@inject IOptions<ExamApiSettings> ExamApiSettingsOptions
@{
    ViewData["Title"] = "AI题目生成";
}

<div id="question-generation-app"></div>

@section Scripts {
    <script>
        // 确保全局命名空间存在
        window.CodeSpirit = window.CodeSpirit || {};
        
        // 注入考试API配置
        window.CodeSpirit.config = {
            examApi: {
                baseUrl: "@ExamApiSettingsOptions.Value.BaseUrl",
                signalR: {
                    questionGenerationHubUrl: "@ExamApiSettingsOptions.Value.SignalR.QuestionGenerationHubUrl"
                }
            }
        };
        
        console.log("题目生成配置已加载", window.CodeSpirit.config);
    </script>
    <resource path="lib/signalr/dist/browser/signalr.min.js" type="js" />
    <resource path="js/question-generation-amis.js" type="js" />
}

@section Styles {
    <resource path="css/question-generation-amis.css" type="css" />
}