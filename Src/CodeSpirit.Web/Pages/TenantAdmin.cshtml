@page "/{tenantId}/admin"
@model CodeSpirit.Web.Pages.TenantAdminModel
@{
    ViewData["Title"] = "租户管理后台";
}

@section Head
{
    <resource path="css/tenant-admin-theme.css" type="css" />
    <resource path="css/tenant-admin.css" type="css" />
}

<div id="root" class="tenant-admin-wrapper"></div>

@section Scripts
{
    <script>
        window.webHost = "@(HttpContext.Request.Scheme + "://" + HttpContext.Request.Host)";
        window.tenantId = "@Model.TenantId";
        window.platformType = "tenant";
    </script>
    <resource path="js/tenant-admin.js" type="js" />
}
