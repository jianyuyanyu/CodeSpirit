@page "/{tenantId}/login"
@model CodeSpirit.Web.Pages.TenantLoginModel
@{
    ViewData["Title"] = "租户登录";
}

@section Head {
    <!-- 预加载字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- SEO 元数据 -->
    <meta name="description" content="安全登录租户管理平台，享受专业的企业级服务">
    <meta name="keywords" content="租户登录,企业管理,安全认证">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    
    <!-- PWA 支持 -->
    <meta name="theme-color" content="#667eea">
    <meta name="msapplication-navbutton-color" content="#667eea">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-capable" content="yes">
    
    <style>
        /* 基础主题CSS变量 */
        :root {
            --tenant-primary-color: #667eea;
            --tenant-primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --tenant-secondary-color: #764ba2;
            --tenant-accent-color: #f093fb;
            --tenant-bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            --tenant-glass-bg: rgba(255, 255, 255, 0.15);
            --tenant-glass-border: rgba(255, 255, 255, 0.3);
            --tenant-text-primary: #333;
            --tenant-text-secondary: #666;
            --tenant-text-light: rgba(255, 255, 255, 0.9);
            --tenant-shadow-light: 0 8px 32px rgba(102, 126, 234, 0.1);
            --tenant-shadow-medium: 0 15px 35px rgba(102, 126, 234, 0.15);
            --tenant-shadow-heavy: 0 25px 50px rgba(102, 126, 234, 0.25);
            --tenant-radius-small: 12px;
            --tenant-radius-medium: 16px;
            --tenant-radius-large: 24px;
            --tenant-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        /* 隐藏默认布局的导航等元素 */
        .navbar, .sidebar, .main-header, .main-sidebar, 
        .content-header, .main-footer {
            display: none !important;
        }
        
        /* 确保内容区域全屏显示 */
        .content-wrapper, .main-content {
            margin: 0 !important;
            padding: 0 !important;
        }
        
        body {
            overflow-x: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        
        /* 预加载动画 */
        .page-preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--tenant-bg-gradient);
            background-size: 400% 400%;
            animation: gradientShift 3s ease infinite;
            z-index: 9998;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            transition: opacity 0.5s ease;
        }
        
        .page-preloader.hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .preloader-logo {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: var(--tenant-primary-color);
            animation: logoSpin 2s ease-in-out infinite;
            box-shadow: var(--tenant-shadow-heavy);
        }
        
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        @keyframes logoSpin {
            0%, 100% { transform: rotate(0deg) scale(1); }
            50% { transform: rotate(180deg) scale(1.1); }
        }
        
        /* 输入框焦点增强动画 */
        .tenant-input-field.focused {
            transform: translateY(-2px);
        }
        
        .tenant-input-field.has-value .cxd-FormItem-label {
            color: var(--tenant-primary-color) !important;
            font-weight: 600 !important;
        }
        
        /* 滚动动画类 */
        .fade-in-up {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease-out;
        }
        
        .fade-in-up.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* 移动端优化 */
        @media (max-width: 768px) {
            .preloader-logo {
                width: 60px;
                height: 60px;
                font-size: 24px;
            }
        }
    </style>
    <resource path="css/tenant-login.css" type="css" />
}

<!-- 页面预加载器 -->
<div id="page-preloader" class="page-preloader">
    <div class="preloader-logo">
        <i class="fa fa-building"></i>
    </div>
</div>

<div id="root" class="tenant-login-root">
    <!-- Loading状态 -->
    <div id="loading" class="tenant-loading">
        <div class="loading-spinner"></div>
        <p>正在加载租户信息...</p>
    </div>
</div>

@section Scripts {
    <!-- 全局变量 -->
    <script>
        window.webHost = '@(HttpContext.Request.Scheme + "://" + HttpContext.Request.Host)';
        window.tenantId = '@Model.TenantId';
        
        // 页面加载完成后隐藏预加载器
        window.addEventListener('load', function() {
            const preloader = document.getElementById('page-preloader');
            if (preloader) {
                setTimeout(() => {
                    preloader.classList.add('hidden');
                    setTimeout(() => {
                        preloader.remove();
                    }, 500);
                }, 300);
            }
        });
        
        // 防止页面缓存问题
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
        
        // 性能监控
        if ('performance' in window) {
            window.addEventListener('load', function() {
                setTimeout(() => {
                    const perfData = performance.getEntriesByType('navigation')[0];
                    if (perfData) {
                        console.log('页面加载性能:', {
                            总时间: Math.round(perfData.loadEventEnd - perfData.navigationStart) + 'ms',
                            DNS查询: Math.round(perfData.domainLookupEnd - perfData.domainLookupStart) + 'ms',
                            连接时间: Math.round(perfData.connectEnd - perfData.connectStart) + 'ms',
                            首次渲染: Math.round(perfData.responseStart - perfData.navigationStart) + 'ms'
                        });
                    }
                }, 0);
            });
        }
    </script>
    
    <resource path="js/token-manager.js" type="js" />
    <resource path="js/tenant-login.js" type="js" />
} 