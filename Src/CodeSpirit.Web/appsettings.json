{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "cache": "redis:6379,defaultDatabase=0,abortConnect=false,connectTimeout=5000,syncTimeout=5000",
    "rabbitmq": "amqp://admin:Password123@rabbitmq:5672",
    "eventbus": "amqp://admin:Password123@rabbitmq:5672",
    "audit": "amqp://admin:Password123@rabbitmq:5672", 
    "messaging": "amqp://admin:Password123@rabbitmq:5672"
  },
  "Jwt": {
    "SecretKey": "ECBF8FA013844D77AE041A6800D7FF8F",
    "Issuer": "codespirit.com",
    "Audience": "CodeSpirit"
  },
  "AllowedHosts": "*",
  "SiteSettings": {
    "SiteName": "CodeSpirit",
    "TopSiteName": "CodeSpirit",
    "LogoUrl": "/favicon.ico",
    "EnableCdn": false,
    "CdnUrl": ""
  },
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default",
    "ResolveFromHeader": true,
    "TenantHeaderName": "TenantId",
    "ResolveFromQuery": true,
    "TenantQueryName": "tenantId",
    "ResolveFromSubdomain": false,
    "ResolveFromPath": true,
    "TenantPathPrefix": "",
    "CacheExpirationMinutes": 30,
    "StoreType": "Database",
    "EnableTenantValidation": true,
    "EnableTenantCache": true,
    "FailureStrategy": "UseDefault"
  },
  "Aspire": {
    "Elastic": {
      "Clients": {
        "Elasticsearch": {
          "DisableHealthChecks": false,
          "DisableTracing": false,
          "HealthCheckTimeout": 3,
          "Endpoint": "http://elastic:Password123@elasticsearch:9200"
        }
      }
    },
    "Seq": {
      "DisableHealthChecks": true,
      "ServerUrl": "http://seq:5341"
    },
    "RabbitMQ": {
      "Client": {
        "ConnectionString": "amqp://admin:Password123@rabbitmq:5672",
        "DisableHealthChecks": true,
        "DisableTracing": true,
        "ExchangeName": "codespirit_event_bus"
      }
    }
  },
  "Audit": {
    "Enabled": true,
    "LogRequestParams": true,
    "LogResponseData": true,
    "LogUnauthorizedRequests": true,
    "LogAnonymousRequests": false,
    "EnableOperationTypeInference": true,
    "EnableGeoLocation": true,
    "ExcludedPathPrefixes": [ "/health", "/metrics", "/swagger", "/favicon.ico" ],
    "RabbitMQ": {
      "ExchangeName": "audit.exchange",
      "QueueName": "audit.queue",
      "RoutingKey": "audit.log"
    },
    "SensitiveData": {
      "Enabled": true,
      "SensitiveFieldPatterns": [ "password", "pwd", "secret", "token", "apiKey", "key", "auth", "credential" ],
      "MaskCharacter": "*",
      "KeepFirstChars": 0,
      "KeepLastChars": 0,
      "ExcludedFields": [ "password", "newPassword", "confirmPassword", "currentPassword" ]
    }
  }
}
