    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\CodeSpirit.Core\CodeSpirit.Core.csproj" />
        <ProjectReference Include="..\CodeSpirit.Audit\CodeSpirit.Audit.csproj" />
        <ProjectReference Include="..\CodeSpirit.LLM\CodeSpirit.LLM.csproj" />
