<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>CodeSpirit.Localization</PackageId>
		<Version>1.0.0</Version>
		<Authors>CodeSpirit Team</Authors>
		<Description>CodeSpirit多语言国际化组件，提供完整的前后端多语言支持</Description>
		<PackageTags>localization;i18n;internationalization;multilingual</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\CodeSpirit.Core\CodeSpirit.Core.csproj" />
		<ProjectReference Include="..\CodeSpirit.MultiTenant\CodeSpirit.MultiTenant.csproj" />
		<ProjectReference Include="..\CodeSpirit.Settings\CodeSpirit.Settings.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 资源文件嵌入配置 -->
		<!-- 注意：不配置 Generator，避免与手动维护的 Resources 类冲突 -->
		<!-- DisplayResources 和 ValidationResources 用于 DataAnnotations 强类型引用 -->
		<!-- ErrorsResources、SharedResources 和 OperationsResources 作为 IStringLocalizer<T> 的占位类 -->
		<EmbeddedResource Update="Resources\Shared.resx" />
		<EmbeddedResource Update="Resources\Errors.resx" />
		<EmbeddedResource Update="Resources\Validation.resx" />
		<EmbeddedResource Update="Resources\Display.resx" />
		<EmbeddedResource Update="Resources\Operations.resx" />
	</ItemGroup>

</Project>
