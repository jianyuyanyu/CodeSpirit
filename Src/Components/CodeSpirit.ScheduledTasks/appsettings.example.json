{
  "ScheduledTasks": {
    "Enabled": true,
    "DefaultTimeout": "00:30:00",
    "MaxConcurrentTasks": 10,
    "TaskCleanupInterval": "01:00:00",
    "ExecutionHistoryRetention": "7.00:00:00",
    "ScanInterval": "00:00:30",
    "DefaultRetryCount": 3,
    "DefaultRetryInterval": "00:01:00",
    "EnablePerformanceMonitoring": true,
    "EnableDetailedLogging": false,
    "Tasks": [
      {
        "Id": "sample-task",
        "Name": "示例任务",
        "Description": "这是一个示例定时任务，每5分钟执行一次",
        "Type": "Cron",
        "CronExpression": "0 */5 * * * *",
        "Enabled": true,
        "ExecutionStrategy": "Distributed",
        "Timeout": "00:05:00",
        "MaxRetryCount": 2,
        "RetryInterval": "00:01:00",
        "HandlerType": "CodeSpirit.ScheduledTasks.Examples.SampleTaskHandler",
        "Parameters": {
          "message": "Hello from scheduled task!",
          "level": "info"
        },
        "Group": "示例",
        "Priority": 5
      },
      {
        "Id": "data-cleanup-task",
        "Name": "数据清理任务",
        "Description": "每天凌晨2点清理过期数据",
        "Type": "Cron",
        "CronExpression": "0 0 2 * * *",
        "Enabled": true,
        "ExecutionStrategy": "Distributed",
        "Timeout": "01:00:00",
        "MaxRetryCount": 1,
        "RetryInterval": "00:30:00",
        "HandlerType": "CodeSpirit.ScheduledTasks.Examples.DataCleanupTaskHandler",
        "Parameters": {
          "cleanupDays": 30,
          "batchSize": 1000
        },
        "Group": "维护",
        "Priority": 8
      },
      {
        "Id": "report-generation-task",
        "Name": "日报生成任务",
        "Description": "每天上午9点生成日报",
        "Type": "Cron",
        "CronExpression": "0 0 9 * * 1-5",
        "Enabled": true,
        "ExecutionStrategy": "Distributed",
        "Timeout": "00:15:00",
        "MaxRetryCount": 2,
        "RetryInterval": "00:05:00",
        "HandlerType": "CodeSpirit.ScheduledTasks.Examples.ReportGenerationTaskHandler",
        "Parameters": {
          "reportType": "DailyReport",
          "format": "PDF",
          "recipients": ["admin@example.com"]
        },
        "Group": "报表",
        "Priority": 6
      },
      {
        "Id": "health-check-task",
        "Name": "健康检查任务",
        "Description": "每分钟检查系统健康状态",
        "Type": "Cron",
        "CronExpression": "0 * * * * *",
        "Enabled": false,
        "ExecutionStrategy": "SingleInstance",
        "Timeout": "00:00:30",
        "MaxRetryCount": 0,
        "HandlerType": "YourNamespace.HealthCheckTaskHandler",
        "Parameters": {
          "checkEndpoints": true,
          "checkDatabase": true,
          "checkCache": true
        },
        "Group": "监控",
        "Priority": 9
      },
      {
        "Id": "backup-task",
        "Name": "数据备份任务",
        "Description": "每周日凌晨3点执行数据备份",
        "Type": "Cron",
        "CronExpression": "0 0 3 * * 0",
        "Enabled": true,
        "ExecutionStrategy": "Distributed",
        "Timeout": "02:00:00",
        "MaxRetryCount": 1,
        "RetryInterval": "01:00:00",
        "HandlerType": "YourNamespace.BackupTaskHandler",
        "Parameters": {
          "backupType": "Full",
          "compression": true,
          "retention": 30
        },
        "Group": "备份",
        "Priority": 10
      },
      {
        "Id": "notification-task",
        "Name": "通知发送任务",
        "Description": "延迟30分钟发送通知",
        "Type": "Delay",
        "DelayTime": "00:30:00",
        "Enabled": false,
        "ExecutionStrategy": "Distributed",
        "Timeout": "00:05:00",
        "MaxRetryCount": 3,
        "RetryInterval": "00:02:00",
        "HandlerType": "YourNamespace.NotificationTaskHandler",
        "Parameters": {
          "template": "welcome",
          "channel": "email"
        },
        "Group": "通知",
        "Priority": 3
      },
      {
        "Id": "onetime-maintenance-task",
        "Name": "一次性维护任务",
        "Description": "在指定时间执行系统维护",
        "Type": "OneTime",
        "ExecuteAt": "2024-12-31T23:59:59Z",
        "Enabled": false,
        "ExecutionStrategy": "Distributed",
        "Timeout": "00:30:00",
        "MaxRetryCount": 0,
        "HandlerType": "YourNamespace.MaintenanceTaskHandler",
        "Parameters": {
          "maintenanceType": "SystemUpdate",
          "notifyUsers": true
        },
        "Group": "维护",
        "Priority": 7
      }
    ]
  }
}
