{
  "MultiTenant": {
    "Enabled": true,
    "DefaultTenantId": "default",
    "ResolveFromHeader": true,
    "TenantHeaderName": "X-Tenant-Id",
    "ResolveFromQuery": false,
    "TenantQueryName": "tenantId",
    "ResolveFromSubdomain": true,
    "ResolveFromPath": false,
    "StoreType": "Api",
    "EnableTenantValidation": true,
    "EnableTenantCache": true,
    "CacheExpirationMinutes": 120,
    "FailureStrategy": "Return404",
    "ApiStore": {
      "BaseUrl": "http://identity-api.default.svc.cluster.local",
      "Timeout": 10,
      "UseApiResponseFormat": true,
      "GetTenantEndpoint": "api/tenants/{tenantId}",
      "GetActiveTenantsEndpoint": "api/tenants/active",
      "CreateTenantEndpoint": "api/tenants",
      "UpdateTenantEndpoint": "api/tenants/{tenantId}",
      "DeleteTenantEndpoint": "api/tenants/{tenantId}",
      "CheckTenantExistsEndpoint": "api/tenants/{tenantId}"
    }
  },
  "Logging": {
    "LogLevel": {
      "CodeSpirit.MultiTenant": "Warning",
      "Default": "Information"
    }
  }
} 