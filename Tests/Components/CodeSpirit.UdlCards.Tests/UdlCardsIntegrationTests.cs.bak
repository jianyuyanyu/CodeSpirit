using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging.Abstractions;
using Microsoft.Extensions.Options;
using CodeSpirit.UdlCards.Core;
using CodeSpirit.UdlCards.Models;
using CodeSpirit.UdlCards.Extensions;

namespace CodeSpirit.UdlCards.Tests;

/// <summary>
/// UDL-Cards SDK 集成测试
/// </summary>
public class UdlCardsIntegrationTests
{
    #region 完整流程测试

    [Fact]
    public void FullWorkflow_CreateMultipleCardsAndGenerateDashboard_ShouldWork()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards(options =>
        {
            options.DefaultTheme = "primary";
            options.EnableCaching = true;
            options.MaxCardsPerPage = 20;
        });

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        // 创建多种类型的卡片
        var cards = new List<UdlCardConfig>
        {
            new StatCardConfig
            {
                Id = "users-count",
                Title = "用户总数",
                Data = new { Value = 1250, Label = "活跃用户" },
                Icon = "fa-users",
                Theme = "primary",
                ShowTrend = true,
                TrendValue = 15.2m,
                TrendType = "up"
            },
            new ChartCardConfig
            {
                Id = "sales-chart",
                Title = "销售趋势",
                ChartType = "line",
                Data = new
                {
                    series = new[]
                    {
                        new { name = "销售额", data = new[] { 100, 200, 300, 250, 400 } }
                    },
                    xAxis = new { categories = new[] { "1月", "2月", "3月", "4月", "5月" } }
                },
                Height = 300,
                ShowLegend = true
            },
            new TableCardConfig
            {
                Id = "recent-orders",
                Title = "最近订单",
                Data = new
                {
                    items = new[]
                    {
                        new { id = 1, customer = "张三", amount = 299.99, status = "已完成" },
                        new { id = 2, customer = "李四", amount = 499.99, status = "处理中" }
                    }
                },
                PageSize = 10,
                Striped = true
            }
        };

        // Act
        var dashboardConfig = generator.GenerateDashboard(cards, "业务仪表板", 30000);

        // Assert
        dashboardConfig.Should().NotBeNull();
        dashboardConfig["type"].Should().Be("page");
        dashboardConfig["title"].Should().Be("业务仪表板");
        dashboardConfig["interval"].Should().Be(30000);

        var body = dashboardConfig["body"] as Dictionary<string, object>;
        body.Should().NotBeNull();
        body["type"].Should().Be("flex");

        var items = body["items"] as List<object>;
        items.Should().NotBeNull();
        items.Should().HaveCount(3);
    }

    [Fact]
    public void CompleteConfiguration_WithAllOptions_ShouldGenerateCorrectOutput()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards(options =>
        {
            options.DefaultTheme = "dark";
            options.EnableCaching = true;
            options.CacheExpirationMinutes = 30;
            options.MaxCardsPerPage = 15;
            options.DefaultRefreshInterval = 5000;
            options.PageConfig = new Dictionary<string, object>
            {
                ["className"] = "custom-dashboard",
                ["style"] = new { backgroundColor = "#1a1a1a" }
            };
            options.LayoutConfig = new Dictionary<string, object>
            {
                ["type"] = "grid",
                ["columns"] = 3,
                ["gap"] = "lg"
            };
            options.DashboardConfig = new Dictionary<string, object>
            {
                ["toolbar"] = new { show = true, position = "top" },
                ["filters"] = new { show = true, collapsible = true }
            };
        });

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();
        var options = serviceProvider.GetRequiredService<IOptions<UdlCardsOptions>>().Value;

        // 验证配置已正确应用
        options.DefaultTheme.Should().Be("dark");
        options.EnableCaching.Should().BeTrue();
        options.CacheExpirationMinutes.Should().Be(30);
        options.MaxCardsPerPage.Should().Be(15);

        // Act - 创建一个复杂的统计卡片
        var statCard = new StatCardConfig
        {
            Id = "complex-stat",
            Title = "复杂统计卡片",
            Data = new { Value = 99.7m, Label = "系统运行率", Unit = "%" },
            Icon = "fa-server",
            IconColor = "#28a745",
            Theme = "success",
            Size = "lg",
            ShowTrend = true,
            TrendValue = 0.3m,
            TrendType = "up",
            TrendLabel = "较昨日",
            ShowProgress = true,
            ProgressValue = 99.7,
            ProgressMax = 100,
            EnableAnimation = true,
            AnimationType = "countUp"
        };

        var result = generator.GenerateCard(statCard);

        // Assert
        result.Should().NotBeNull();
        result["theme"].Should().Be("success");
        result["size"].Should().Be("lg");
        result["showTrend"].Should().Be(true);
        result["showProgress"].Should().Be(true);
        result["enableAnimation"].Should().Be(true);
    }

    #endregion

    #region 性能测试

    [Fact]
    public void Performance_GenerateMultipleCards_ShouldCompleteQuickly()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards();

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        // 创建大量卡片
        var cards = new List<UdlCardConfig>();
        for (int i = 0; i < 100; i++)
        {
            cards.Add(new StatCardConfig
            {
                Id = $"stat-{i}",
                Title = $"统计卡片 {i}",
                Data = new { Value = i * 10, Label = $"指标{i}" }
            });

            cards.Add(new ChartCardConfig
            {
                Id = $"chart-{i}",
                Title = $"图表卡片 {i}",
                ChartType = "line",
                Data = new { series = new[] { new { name = "数据", data = new[] { i, i * 2, i * 3 } } } }
            });
        }

        // Act & Assert - 应该在合理时间内完成
        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        
        var result = generator.GeneratePage(cards);
        
        stopwatch.Stop();
        
        result.Should().NotBeNull();
        stopwatch.ElapsedMilliseconds.Should().BeLessThan(1000); // 应该在1秒内完成
    }

    #endregion

    #region 错误处理测试

    [Fact]
    public void ErrorHandling_WithInvalidCards_ShouldHandleGracefully()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards();

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        var cards = new List<UdlCardConfig>
        {
            new StatCardConfig { Id = "valid-stat", Title = "有效卡片", Data = new { Value = 100 } },
            new StatCardConfig { Id = "", Title = "无效卡片", Data = new { Value = 200 } }, // 无效ID
            new StatCardConfig { Id = "another-valid", Title = "另一个有效卡片", Data = new { Value = 300 } }
        };

        // Act & Assert - 应该跳过无效卡片，但不崩溃
        var result = generator.GeneratePage(cards);
        
        result.Should().NotBeNull();
        var body = result["body"] as Dictionary<string, object>;
        var items = body["items"] as List<object>;
        
        // 应该只包含有效的卡片
        items.Should().HaveCount(2);
    }

    [Fact]
    public void ErrorHandling_WithNullCardsList_ShouldReturnEmptyPage()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards();

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        // Act
        var result = generator.GeneratePage(null);

        // Assert
        result.Should().NotBeNull();
        var body = result["body"] as Dictionary<string, object>;
        var items = body["items"] as List<object>;
        items.Should().BeEmpty();
    }

    #endregion

    #region 扩展性测试

    [Fact]
    public void Extensibility_WithCustomCardType_ShouldSupportExtension()
    {
        // Arrange
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards();
        
        // 可以添加自定义建构器
        // services.AddSingleton<IUdlCardBuilder<CustomCardConfig>, CustomCardBuilder>();

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        // Act - 测试现有卡片类型的组合使用
        var mixedCards = new List<UdlCardConfig>
        {
            new StatCardConfig 
            { 
                Id = "stat-1", 
                Title = "统计", 
                Data = new { Value = 100 },
                CustomProperties = new Dictionary<string, object>
                {
                    ["customField"] = "自定义值",
                    ["onClick"] = "customHandler()"
                }
            },
            new ChartCardConfig 
            { 
                Id = "chart-1", 
                Title = "图表", 
                ChartType = "pie",
                Data = new { value = 50 },
                CustomProperties = new Dictionary<string, object>
                {
                    ["theme"] = "custom-theme",
                    ["animation"] = new { duration = 2000 }
                }
            }
        };

        var result = generator.GeneratePage(mixedCards);

        // Assert
        result.Should().NotBeNull();
        var body = result["body"] as Dictionary<string, object>;
        var items = body["items"] as List<object>;
        items.Should().HaveCount(2);

        // 验证自定义属性被正确包含
        var firstCard = items[0] as Dictionary<string, object>;
        firstCard.Should().ContainKey("customField");
        firstCard.Should().ContainKey("onClick");
    }

    #endregion

    #region 实际使用场景测试

    [Fact]
    public void RealWorldScenario_BusinessDashboard_ShouldGenerateCompleteConfig()
    {
        // Arrange - 模拟真实的业务场景
        var services = new ServiceCollection();
        services.AddLogging();
        services.AddUdlCards(options =>
        {
            options.DefaultTheme = "primary";
            options.DefaultRefreshInterval = 60000; // 1分钟刷新
            options.LayoutConfig = new Dictionary<string, object>
            {
                ["type"] = "flex",
                ["wrap"] = "wrap",
                ["gap"] = "base"
            };
        });

        var serviceProvider = services.BuildServiceProvider();
        var generator = serviceProvider.GetRequiredService<UdlCardsGenerator>();

        // 业务指标卡片
        var businessCards = new List<UdlCardConfig>
        {
            // 关键指标
            new StatCardConfig
            {
                Id = "revenue",
                Title = "今日营收",
                Data = new { Value = 125680.50m, Label = "人民币", Unit = "元" },
                Icon = "fa-money-bill-wave",
                Theme = "success",
                ShowTrend = true,
                TrendValue = 8.5m,
                TrendType = "up",
                TrendLabel = "较昨日"
            },
            
            new StatCardConfig
            {
                Id = "orders",
                Title = "订单数量",
                Data = new { Value = 2890, Label = "笔订单" },
                Icon = "fa-shopping-cart",
                Theme = "primary",
                ShowProgress = true,
                ProgressValue = 2890,
                ProgressMax = 3000
            },

            // 趋势图表
            new ChartCardConfig
            {
                Id = "sales-trend",
                Title = "销售趋势图",
                ChartType = "line",
                Data = new
                {
                    series = new[]
                    {
                        new 
                        { 
                            name = "销售额", 
                            data = new[] { 12000, 15000, 18000, 16000, 20000, 22000, 25000 }
                        }
                    },
                    xAxis = new 
                    { 
                        categories = new[] { "周一", "周二", "周三", "周四", "周五", "周六", "周日" }
                    }
                },
                Height = 400,
                ShowLegend = true,
                ShowTooltip = true
            },

            // 数据表格
            new TableCardConfig
            {
                Id = "top-products",
                Title = "热销商品",
                Data = new
                {
                    items = new[]
                    {
                        new { rank = 1, product = "iPhone 15", sales = 1250, revenue = "1,249,000" },
                        new { rank = 2, product = "MacBook Pro", sales = 890, revenue = "1,780,000" },
                        new { rank = 3, product = "iPad Air", sales = 1560, revenue = "936,000" }
                    }
                },
                Columns = new List<Dictionary<string, object>>
                {
                    new() { ["name"] = "rank", ["label"] = "排名", ["width"] = 80 },
                    new() { ["name"] = "product", ["label"] = "商品名称", ["width"] = 200 },
                    new() { ["name"] = "sales", ["label"] = "销量", ["width"] = 100 },
                    new() { ["name"] = "revenue", ["label"] = "收入", ["width"] = 120 }
                },
                PageSize = 10,
                Striped = true
            }
        };

        // Act
        var dashboard = generator.GenerateDashboard(
            businessCards, 
            "业务运营仪表板", 
            60000);

        // Assert
        dashboard.Should().NotBeNull();
        dashboard["title"].Should().Be("业务运营仪表板");
        dashboard["interval"].Should().Be(60000);
        
        var body = dashboard["body"] as Dictionary<string, object>;
        body.Should().NotBeNull();
        
        var items = body["items"] as List<object>;
        items.Should().HaveCount(4);

        // 验证每种卡片类型都被正确生成
        var cardTypes = items.Cast<Dictionary<string, object>>()
                            .Select(item => item["cardType"].ToString())
                            .ToList();
        
        cardTypes.Should().Contain("stat");
        cardTypes.Should().Contain("chart");
        cardTypes.Should().Contain("table");
    }

    #endregion
} 